<Window x:Class="DemAppGazinskaa.ManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин обуви — менеджер" Height="600" Width="1100"
        FontFamily="Times New Roman" Background="White"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Icon.png" Height="60" Width="60" Stretch="Uniform"/>
            <Button Content="Товары" Height="30" Width="100" Margin="20,0,0,0"
                    Background="#00FA9A" Click="ShowProducts_Click"/>
            <Button Content="Заказы" Height="30" Width="100" Margin="10,0,0,0"
                    Background="#00FA9A" Click="ShowOrders_Click"/>
            <Button Content="Выйти" Height="30" Width="90" Margin="650,0,0,0"
                    Background="#00FA9A" Click="Exit_Click"/>
        </StackPanel>

        <!-- Панель фильтров (только для товаров) -->
        <StackPanel x:Name="FilterPanel" Grid.Row="1"
                    Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="tbSearch" Width="220" Height="26"
                     TextChanged="tbSearch_TextChanged"/>
            <ComboBox x:Name="cbSort" Width="180" Height="26" Margin="10,0,0,0"
                      SelectionChanged="cbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <ComboBox x:Name="cbFilter" Width="200" Height="26" Margin="10,0,0,0"
                      SelectionChanged="cbFilter_SelectionChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="0-1000"/>
                <ComboBoxItem Content="1000-5000"/>
                <ComboBoxItem Content="5000+"/>
            </ComboBox>
        </StackPanel>

        <!-- Товары -->
        <DataGrid x:Name="dgProducts" Grid.Row="2" Margin="0,10,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="90"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="130"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="90"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding Discount}" Width="70"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity_stock}" Width="70"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Заказы (скрыт по умолчанию) -->
        <DataGrid x:Name="dgOrders" Grid.Row="2" Margin="0,10,0,0"
                  Visibility="Collapsed"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding ZakazID}" Width="60"/>
                <DataGridTextColumn Header="Артикулы" Binding="{Binding Article}" Width="250"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding Order_date}" Width="120"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding Deliver_date}" Width="120"/>
                <DataGridTextColumn Header="ПВЗ" Binding="{Binding Pvz}" Width="70"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding Fio}" Width="200"/>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="70"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>